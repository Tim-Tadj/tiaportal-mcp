<Project>
  <Target Name="ValidateTiaVersion" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(TiaMajorVersion)' != '19' And '$(TiaMajorVersion)' != '20' And '$(TiaMajorVersion)' != '21'"
           Text="TiaMajorVersion must be 19, 20 or 21." />
  </Target>
  <Target Name="ValidateTiaApi" BeforeTargets="ResolveReferences" Condition="'$(MSBuildProjectName)' == 'TiaMcpServer'">
    <PropertyGroup>
      <TiaApiAssemblyFile>Siemens.Engineering.dll</TiaApiAssemblyFile>
      <TiaApiAssemblyFile Condition="'$(TiaMajorVersion)' == '21'">Siemens.Engineering.Base.dll</TiaApiAssemblyFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(SiemensEngineeringDirectory)\$(TiaApiAssemblyFile)')"
           Text="TIA V$(TiaMajorVersion) PublicAPI assemblies are missing: $(TiaApiAssemblyFile) in '$(SiemensEngineeringDirectory)'. Set TiaPortalLocation to the matching TIA installation. An older API cannot validate this build." />
    <GetAssemblyIdentity AssemblyFiles="$(SiemensEngineeringDirectory)\$(TiaApiAssemblyFile)">
      <Output TaskParameter="Assemblies" ItemName="TiaApiIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="$([System.Version]::Parse('%(TiaApiIdentity.Version)').Major) != $(TiaMajorVersion)"
           Text="Siemens.Engineering API %(TiaApiIdentity.Version) does not match TiaMajorVersion=$(TiaMajorVersion)." />
  </Target>
</Project>
