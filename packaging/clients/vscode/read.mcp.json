{
  "inputs": [
    {
      "type": "promptString",
      "id": "tiaPortalMcpReadBundle",
      "description": "Absolute path to the extracted TIA Portal MCP Read bundle"
    }
  ],
  "servers": {
    "tia-portal-mcp-read": {
      "type": "stdio",
      "command": "${input:tiaPortalMcpReadBundle}\\server\\TiaPortalMcp.exe",
      "args": [
        "--access-profile",
        "Read",
        "--tia-version",
        "Auto"
      ],
      "env": {}
    }
  }
}
