{
  "schemaVersion": 1,
  "productVersion": "__VERSION__",
  "platform": "win-x64",
  "bundledTiaVersions": [
    17,
    18,
    19
  ],
  "plannedTiaVersions": [
    20,
    21
  ],
  "tiaVersionValidation": {
    "17": {
      "bundled": true,
      "runtimeValidated": false,
      "classification": "experimental-build-only"
    },
    "18": {
      "bundled": true,
      "runtimeValidated": false,
      "classification": "experimental-build-only"
    },
    "19": {
      "bundled": true,
      "runtimeValidated": false,
      "classification": "experimental-prior-runtime-evidence"
    },
    "20": {
      "bundled": false,
      "runtimeValidated": false,
      "classification": "planned-later-alpha"
    },
    "21": {
      "bundled": false,
      "runtimeValidated": false,
      "classification": "unsupported-in-this-release"
    }
  },
  "supportStatus": "experimental",
  "siemensRuntime": {
    "runtimeOrObjectCodeDllsBundled": false,
    "assemblySource": "local-tia-portal-installation"
  },
  "clients": {
    "claudeDesktop": {
      "distribution": "mcpb",
      "transport": "stdio",
      "execution": "local"
    },
    "vscode": {
      "distribution": "bundled-installer",
      "transport": "stdio",
      "execution": "local"
    },
    "chatgpt": {
      "distribution": "bundled-secure-tunnel-kit",
      "transport": "stdio-via-secure-mcp-tunnel",
      "serverExecution": "local",
      "connection": "outbound-https-to-openai",
      "directLocalConnection": false
    }
  },
  "profiles": {
    "read": {
      "package": "tia-portal-mcp-__VERSION__-read-win-x64.zip",
      "vscodeInstaller": "clients/vscode/Install-VsCodeMcp.ps1",
      "chatgptTunnelSetup": "clients/chatgpt/Configure-ChatGptTunnel.ps1"
    },
    "readwrite": {
      "package": "tia-portal-mcp-__VERSION__-readwrite-win-x64.zip",
      "vscodeInstaller": "clients/vscode/Install-VsCodeMcp.ps1",
      "chatgptTunnelSetup": "clients/chatgpt/Configure-ChatGptTunnel.ps1"
    }
  }
}
